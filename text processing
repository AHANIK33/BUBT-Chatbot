import re

def clean_text(text):
    """
    Clean user input before processing
    """

    text = text.lower()

    text = re.sub(
        r"[^a-zA-z0-9\s]",
        " ",
        text
    )

    text = re.sub(
        "\s+",
        " ",
        text
    )

    text = text.strip()

    return text
